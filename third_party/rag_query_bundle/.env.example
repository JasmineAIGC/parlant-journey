# ParlantRAG 环境变量配置
# 复制此文件为 .env 并填写实际值。
# 命名与 temp/llm/.env 保持一致，QWEN3_* 系列变量优先读取。

# ==============================================================================
# LLM 配置（Qwen3 / vLLM — 用于 examples/03、examples/05 的评估/问答）
# examples/05_plan_a_agent.py 与 examples/06_rag_query.py 会自动将这里的配置
# 桥接为 Parlant 所需的 LITELLM_PROVIDER_* 环境变量，并以
#   p.Server(nlp_service=p.NLPServices.litellm)
# 启动 NLP 服务，保证 Parlant 模式使用的是这里配置的模型，不会调用其他服务。
# ==============================================================================
QWEN3_API_KEY=sk-7e7c8b9ad0e1f2a3b4c5
QWEN3_BASE_URL=http://10.112.172.30:18023/v1
QWEN3_MODEL=Qwen2.5-7B-Instruct
QWEN3_TOP_K=20
QWEN3_MAX_TOKENS=8192
# QWEN3_TEMPERATURE=0.0   # 默认 0.0（评估时使用确定性输出）
# LLM_SSL_VERIFY=false    # SSL 证书验证；内网自签名证书 / HTTP 端点默认 false；生产可设 true

# （可选）若需手动覆盖 Parlant NLP 配置，可直接设置以下变量；
# 未设置时脚本会自动从上面的 QWEN3_* / LLM_* 推导。
# LITELLM_PROVIDER_BASE_URL=http://10.112.172.30:18023/v1
# LITELLM_PROVIDER_API_KEY=sk-xxx
# LITELLM_PROVIDER_MODEL_NAME=openai/Qwen2.5-7B-Instruct
# LITELLM_EMBEDDING_MODEL_NAME=openai/Qwen3-Embedding-8B

# ==============================================================================
# Embedding 配置（用于 plan_a.rag.Embedder — 须与构建知识库时的模型一致）
# ==============================================================================
# 方式一：本地 sentence-transformers
# EMBEDDING_MODEL_PATH=/share/airesearch/data/aowen.xiao/models/BAAI/bge-large-zh-v1.5
# EMBEDDING_MODEL=bge-large-zh-v1.5


# 方式二：API 服务（vLLM serving embedding model）
EMBEDDING_BASE_URL=http://10.112.172.30:18024/v1
EMBEDDING_API_KEY=sk-7e7c8b9ad0e1f2a3b4c5
EMBEDDING_MODEL=Qwen3-Embedding-8B

# ==============================================================================
# 知识库路径（FAISS 索引目录，供 plan_a.RAGPipeline 使用）
# 指向具体的索引子目录（含 faiss_index.bin / docstore.json 等文件）
# 例：FlexRAG 构建后的结构为 knowledge_base/knowledge_persist_dir/<dataset>/
# ==============================================================================
KNOWLEDGE_PERSIST_DIR=./knowledge_base/knowledge_persist_dir/hotpotqa
