# parlant-journey 环境变量配置模板
# 复制此文件为 .env 并填写实际值：
#   cp .env.example .env
#
# tools/llm 和 tools/embedding 会自动按以下顺序查找 .env：
#   1. 当前工作目录的 .env
#   2. 当前工作目录的 third_party/.env（兼容旧结构）
#   3. 向上逐级查找（最多 5 层）

# ==============================================================================
# LLM 配置（tools/llm — LLMClient / LLMConfig）
# 变量优先级：QWEN3_* > LLM_* > OPENAI_*
# ==============================================================================
QWEN3_API_KEY=your-api-key-here
QWEN3_BASE_URL=http://your-llm-server:port/v1
QWEN3_MODEL=Qwen2.5-7B-Instruct
QWEN3_TOP_K=20
QWEN3_MAX_TOKENS=8192
# QWEN3_TEMPERATURE=0.0   # 默认 0.0；生成场景可适当调高
# LLM_SSL_VERIFY=false    # 内网自签名证书 / HTTP 端点请设为 false

# 通用 LLM 别名（当 QWEN3_* 未设置时生效）
# LLM_API_KEY=your-api-key-here
# LLM_BASE_URL=http://your-llm-server:port/v1
# LLM_MODEL=Qwen2.5-7B-Instruct

# OpenAI 官方服务别名（优先级最低）
# OPENAI_API_KEY=sk-...

# ==============================================================================
# Embedding 配置（tools/embedding — OpenAILikeEmbedding；Parlant LiteLLM）
# ==============================================================================
EMBEDDING_BASE_URL=http://your-embedding-server:port/v1
EMBEDDING_API_KEY=your-api-key-here
EMBEDDING_MODEL=Qwen3-Embedding-8B
# EMBEDDING_DIMENSIONS=1536    # Embedding 向量维度；默认 1536，按实际模型设置
                               # 例：bge-large-zh-v1.5 = 1024；jina-v2-base-en = 768

# Parlant 运行时 Embedding 说明：
#   bridge_parlant_litellm_env() 会自动将 EMBEDDING_MODEL 桥接到
#   LITELLM_EMBEDDING_MODEL_NAME，从而告知 Parlant 使用上方配置的 Embedding 模型。
#   若不设置 EMBEDDING_MODEL，Parlant 将默认尝试从 HuggingFace 下载
#   jinaai/jina-embeddings-v2-base-en（内网环境下会失败）。
#
#   注意：Parlant LiteLLM Service 复用 QWEN3_BASE_URL（即 LITELLM_PROVIDER_BASE_URL）
#   作为 Embedding 服务地址；若 Embedding 模型与 LLM 部署在同一 vLLM 实例则无需额外配置。

# 本地 sentence-transformers 模式（与 API 模式二选一）
# EMBEDDING_MODEL_PATH=/path/to/model/BAAI/bge-large-zh-v1.5

# ==============================================================================
# 知识库路径（tools/embedding 相关 RAG 场景）
# ==============================================================================
# KNOWLEDGE_PERSIST_DIR=./knowledge_base/knowledge_persist_dir/your_dataset
